# Copy to `.env` and adjust. This file documents two separate consumers of env vars.

# -----------------------------------------------------------------------------
# Local OpenMRS dev shell (`yarn start:local` → tools/start-openmrs-develop.mjs)
# Only OPENMRS_* and NODE_* keys from .env are merged into the `openmrs` child process.
#
# Backend: CLI `--backend` overrides OPENMRS_BACKEND_URL; if neither is set, defaults to
# https://dev2.openmrs.org
# -----------------------------------------------------------------------------
OPENMRS_DEVELOP_HOST=0.0.0.0
OPENMRS_DEVELOP_PORT=9100
OPENMRS_BACKEND_URL=http://localhost:8092
NODE_TLS_REJECT_UNAUTHORIZED=0

# -----------------------------------------------------------------------------
# Playwright E2E (`yarn test-e2e` → playwright.config.ts loads full .env via dotenv)
# These are NOT used by `openmrs develop`. baseURL = `${E2E_BASE_URL}/spa/`
# -----------------------------------------------------------------------------
E2E_BASE_URL=http://localhost:8080/openmrs
E2E_USER_ADMIN_USERNAME=admin
E2E_USER_ADMIN_PASSWORD=Admin123
E2E_LOGIN_DEFAULT_LOCATION_UUID=44c3efb0-2583-4c80-a79e-1f756a03c0a1
# The above location UUID is for the "Outpatient Clinic" location in the reference application
